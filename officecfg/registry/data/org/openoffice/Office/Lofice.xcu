<!DOCTYPE oor:component-data SYSTEM "../../../../component-update.dtd">
<oor:component-data xmlns:install="http://openoffice.org/2004/installation" xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" oor:package="org.openoffice.Office" oor:name="Lofice">
  <node oor:name="AiSettings">
    <prop oor:name="UseBuiltinAi" oor:type="xs:boolean">
      <value>true</value>
    </prop>
    <prop oor:name="Endpoint" oor:type="xs:string">
      <value></value>
    </prop>
    <prop oor:name="ApiKey" oor:type="xs:string">
      <value></value>
    </prop>
    <prop oor:name="Model" oor:type="xs:string">
      <value>lofice-default</value>
    </prop>
    <prop oor:name="TimeoutSeconds" oor:type="xs:int">
      <value>30</value>
    </prop>
    <prop oor:name="ChatHistoryJson" oor:type="xs:string">
      <value></value>
    </prop>
    <prop oor:name="UseRagContext" oor:type="xs:boolean">
      <value>true</value>
    </prop>
    <prop oor:name="RagEndpoint" oor:type="xs:string">
      <value>https://lofice-rag-api.vercel.app/search</value>
    </prop>
    <prop oor:name="RagTimeoutSeconds" oor:type="xs:int">
      <value>8</value>
    </prop>
    <prop oor:name="AutoSendQuickActionPrompt" oor:type="xs:boolean">
      <value>true</value>
    </prop>
  </node>
</oor:component-data>
