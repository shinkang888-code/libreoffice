#include "macros.inc"

#include "AutoInstall/loficekit"

Module gid_Module_loficekit
    Name = "loficekit Data";
    Description = "loficekit Data";
    PackageInfo = "packinfo_office.txt";
    ParentID = gid_Module_Root_Brand;
    Styles = (HIDDEN_ROOT);
    Dirs = (gid_Dir_Share_loficekit);
    Files = (auto_loficekit_ALL);
End

Directory gid_Dir_Share_loficekit
    ParentID = gid_Brand_Dir_Share;
    DosName = "loficekit";
End

